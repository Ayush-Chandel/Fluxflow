rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Workspace-scoped access: a user's token carries a `workspaceId` claim
    // (see api/setWorkspaceClaims.ts) that must match the path segment.
    //
    // Read the claim via .get() with a default, NEVER as
    // `request.auth.token.workspaceId`: on a token that lacks the claim the bare
    // property access is a hard evaluation error ("Property workspaceId is
    // undefined on object") that aborts the whole commit, which surfaces client
    // side as a dead WebChannel Write stream rather than a catchable failure.
    // With the default, an unclaimed token is a plain permission-denied the
    // stores' rollback paths already handle.
    //
    // NOTE: issues (step 7), projects (step 11), cycles (step 13) and templates
    // (step 14) are covered here; the full hardening pass — field-level
    // validation on updates — is step 18 (§8, §14.2).
    function inWorkspace(ws) {
      return request.auth != null && request.auth.token.get('workspaceId', '') == ws;
    }

    match /workspaces/{ws} {
      allow read: if inWorkspace(ws);

      // Issues are created by the Vercel Fn (api/createIssue) so it can mint the
      // sequential 'LIN-N' identifier — clients are create-blocked.
      match /issues/{id} {
        allow read, update, delete: if inWorkspace(ws);
        allow create: if false;
      }

      // Projects carry no server-generated field, so the client SDK creates them
      // directly (build order 11).
      //
      // MILESTONES need no rule of their own: they are a map FIELD on the project
      // document (§4, build order 12), so every milestone write is an update to
      // the project and is already covered here. The subcollection path that the
      // original plan used stays denied by default, which is now correct — nothing
      // writes there.
      match /projects/{id} {
        allow read, create, update, delete: if inWorkspace(ws);
      }

      // Cycles carry a server-sequential `number` (api/createCycle), so clients
      // are create-blocked here exactly like issues (build order 13).
      match /cycles/{id} {
        allow read, update, delete: if inWorkspace(ws);
        allow create: if false;
      }

      // Templates are pure client CRUD like projects — nothing on them is
      // server-generated, so the store mints the id and writes directly.
      // The default swap writes two documents in one batch (templateService
      // .setDefault); a batch is evaluated per-document, so both are covered by
      // this single rule.
      match /templates/{id} {
        allow read, create, update, delete: if inWorkspace(ws);
      }
    }
  }
}
